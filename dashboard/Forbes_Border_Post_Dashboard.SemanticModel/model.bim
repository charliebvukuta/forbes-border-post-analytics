            "name": "Unrecovered Gap",
            "displayFolder": "Revenue",
            "expression": "[Total Revenue Gap] - [Revenue Recovered]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "4ca8163b-53a9-4dd0-8897-e18098f33549"
          },
          {
            "name": "Recovery Rate",
            "displayFolder": "Revenue",
            "expression": "DIVIDE ( [Revenue Recovered], [Total Revenue Gap] )",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "3c3095e7-49d5-4491-a616-c79ce84d2f48"
          },
          {
            "name": "Gap % of Assessed",
            "displayFolder": "Revenue",
            "expression": "DIVIDE ( [Total Revenue Gap], [Total Assessed Revenue] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "415c8501-725c-47d2-8bec-002dde3d93f6"
          },
          {
            "name": "Gap Detected",
            "displayFolder": "Detection",
            "expression": "CALCULATE ( [Total Revenue Gap], Transactions[Offence_Detected] = \"Yes\" )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "a4916849-8e5f-4c07-898d-831ab67849e3"
          },
          {
            "name": "Gap Never Inspected",
            "displayFolder": "Detection",
            "expression": "CALCULATE ( [Total Revenue Gap], Transactions[Inspection_Conducted] = \"No\" )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "174ba107-17b5-4f47-b4e3-17afc33629c4"
          },
          {
            "name": "Gap Never Inspected %",
            "displayFolder": "Detection",
            "expression": "DIVIDE ( [Gap Never Inspected], [Total Revenue Gap] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "89cfeabb-58b0-4645-8f01-b178e463e72f"
          },
          {
            "name": "Recovery Rate on Detected Gaps",
            "displayFolder": "Detection",
            "expression": "DIVIDE ( [Revenue Recovered], [Gap Detected] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "898b78b1-06a8-4713-bfcb-b75a5c26aa57"
          },
          {
            "name": "Gap Share %",
            "displayFolder": "Revenue",
            "expression": "DIVIDE ( [Total Revenue Gap], CALCULATE ( [Total Revenue Gap], ALLSELECTED ( Transactions ) ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "49c15fc4-c548-493f-a5ec-080414e30315"
          },
          {
            "name": "Declarations",
            "displayFolder": "Inspection",
            "expression": "COUNTROWS ( Transactions )",
            "formatString": "#,0",
            "lineageTag": "48377ae8-75ea-4267-adb5-8b9174d9032d"
          },
          {
            "name": "Declarations With Gap",
            "displayFolder": "Inspection",
            "expression": "CALCULATE ( [Declarations], Transactions[Has_Revenue_Gap] = \"Yes\" )",
            "formatString": "#,0",
            "lineageTag": "606a6414-297d-42d5-8c0e-5d4f60f05dfc"
          },
          {
            "name": "Gap Incidence",
            "displayFolder": "Inspection",
            "expression": "DIVIDE ( [Declarations With Gap], [Declarations] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "8b002f5c-b554-4c61-8f6b-fe0b99681a51"
          },
          {
            "name": "Inspections",
            "displayFolder": "Inspection",
            "expression": "CALCULATE ( [Declarations], Transactions[Inspection_Conducted] = \"Yes\" )",
            "formatString": "#,0",
            "lineageTag": "db4ec963-614d-4494-ab9d-8e0b6bf74611"
          },
          {
            "name": "Inspection Rate",
            "displayFolder": "Inspection",
            "expression": "DIVIDE ( [Inspections], [Declarations] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "105fbfc7-2033-4697-bed4-de3ca9f81014"
          },
          {
            "name": "Offences",
            "displayFolder": "Inspection",
            "expression": "CALCULATE ( [Declarations], Transactions[Offence_Detected] = \"Yes\" )",
            "formatString": "#,0",
            "lineageTag": "255afd8b-3242-42cc-9d26-72be7853fdff"
          },
          {
            "name": "Inspection Hit Rate",
            "displayFolder": "Inspection",
            "expression": "DIVIDE ( [Offences], [Inspections] )",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "dc5f3cf3-1411-4ca5-8664-c3c7b3c8f929"
          },
          {
            "name": "Avg Model Gap Probability",
            "displayFolder": "Model",
            "expression": "AVERAGE ( ModelScores[Model_Gap_Probability] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "0bee1374-0585-4147-a2ba-852aac49f1bf"
          },
          {
            "name": "Revenue Target",
            "displayFolder": "Targets",
            "expression": "SUMX ( VALUES ( 'Calendar'[Month] ), LOOKUPVALUE ( Targets[Revenue_Target_USD], Targets[Month], 'Calendar'[Month] ) )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "6888434a-8be4-4a65-889b-97875cc170d8"
          },
          {
            "name": "Target Achievement %",
            "displayFolder": "Targets",
            "expression": "DIVIDE ( [Total Assessed Revenue], [Revenue Target] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "ae67691b-4a64-437b-bb18-aced4e342a5a"
          },
          {
            "name": "Shortfall vs Target",
            "displayFolder": "Targets",
            "expression": "[Revenue Target] - [Total Assessed Revenue]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "73a3714d-008e-484d-bec3-86e30db07390"
          },
          {
            "name": "Revenue in Part-paid or Pending",
            "displayFolder": "Collections",
            "expression": "CALCULATE ( [Total Assessed Revenue], Transactions[Payment_Status] IN { \"Part-paid\", \"Pending\" } )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "8cb86c20-478d-4166-b5a7-ab59cc01beeb"
          },
          {
            "name": "Part-paid or Pending %",
            "displayFolder": "Collections",
            "expression": "DIVIDE ( [Revenue in Part-paid or Pending], [Total Assessed Revenue] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "70c79532-bcf3-4988-acd6-33bc042187db"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table(type table [Column1 = text], {})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}