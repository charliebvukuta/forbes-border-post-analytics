          {
            "name": "TargetingComparison",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectFolder & \"reports\\model_targeting_comparison.csv\"), [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    NoHeader = Table.Skip(Source, 1),",
                "    Renamed = Table.RenameColumns(NoHeader, {{\"Column1\", \"Strategy\"}, {\"Column2\", \"Gap cases caught\"}, {\"Column3\", \"Gap USD caught\"}, {\"Column4\", \"% of gap cases\"}, {\"Column5\", \"% of gap USD\"}, {\"Column6\", \"Hit rate %\"}}),",
                "    Typed = Table.TransformColumnTypes(Renamed, {{\"Strategy\", type text}, {\"Gap cases caught\", type number}, {\"Gap USD caught\", type number}, {\"% of gap cases\", type number}, {\"% of gap USD\", type number}, {\"Hit rate %\", type number}}, \"en-US\"),",
                "    AddType = Table.AddColumn(Typed, \"Strategy Type\", each if Text.StartsWith([Strategy], \"Model\") then \"Data-driven model\" else if [Strategy] = \"Random selection\" then \"Random\" else \"Current practice\", type text),",
                "    Reordered = Table.ReorderColumns(AddType, {\"Strategy\", \"Strategy Type\", \"Gap cases caught\", \"Gap USD caught\", \"% of gap cases\", \"% of gap USD\", \"Hit rate %\"})",
                "in",
                "    Reordered"
              ],
              "type": "m"
            }
          }
        ]
      },
