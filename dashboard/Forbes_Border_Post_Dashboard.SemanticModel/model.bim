        "partitions": [
          {
            "name": "Transactions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectFolder & \"data\\processed\\cleaned_customs_transactions.csv\"), [Delimiter=\",\", Columns=29, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Declaration_ID\", type text}, {\"Declaration_Date\", type date}, {\"Border_Post\", type text}, {\"Importer_ID\", type text}, {\"Country_of_Origin\", type text}, {\"Commodity_Description\", type text}, {\"HS_Code\", type text}, {\"Risk_Category\", type text}, {\"Declared_Customs_Value_USD\", type number}, {\"Assessed_Customs_Value_USD\", type number}, {\"Declared_Customs_Duty_USD\", type number}, {\"Assessed_Customs_Duty_USD\", type number}, {\"Declared_Import_VAT_USD\", type number}, {\"Assessed_Import_VAT_USD\", type number}, {\"Declared_Excise_USD\", type number}, {\"Assessed_Excise_USD\", type number}, {\"Declared_Total_Revenue_USD\", type number}, {\"Assessed_Total_Revenue_USD\", type number}, {\"Inspection_Conducted\", type text}, {\"Offence_Detected\", type text}, {\"Offence_Type\", type text}, {\"Potential_Revenue_Gap_USD\", type number}, {\"Additional_Revenue_Recovered_USD\", type number}, {\"Payment_Status\", type text}, {\"DQ_Assessed_Components_Mismatch\", type text}, {\"DQ_Assessed_Below_Declared\", type text}, {\"Month\", type text}, {\"Has_Revenue_Gap\", type text}, {\"Gap_Pct_of_Declared\", type number}}, \"en-US\"),",
                "    AddRiskOrder = Table.AddColumn(Typed, \"Risk Order\", each if [Risk_Category] = \"Low\" then 1 else if [Risk_Category] = \"Medium\" then 2 else 3, Int64.Type),",
                "    AddStage = Table.AddColumn(AddRiskOrder, \"Detection Stage\", each if [Inspection_Conducted] = \"No\" then \"1. Not inspected\" else if [Offence_Detected] = \"No\" then \"2. Inspected - no offence\" else \"3. Offence detected\", type text)",
                "in",
                "    AddStage"
              ],
              "type": "m"
            }
          }
        ]
