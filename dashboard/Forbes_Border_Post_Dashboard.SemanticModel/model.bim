          }
        ],
        "lineageTag": "486cfafa-749d-4922-b077-3e3c4f02fd4a",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Dates = List.Dates(#date(2025, 1, 1), 365, #duration(1, 0, 0, 0)),",
                "    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(AsTable, {{\"Date\", type date}}),",
                "    AddMonth = Table.AddColumn(Typed, \"Month\", each Date.ToText([Date], [Format=\"yyyy-MM\", Culture=\"en-US\"]), type text),",
                "    AddMonthName = Table.AddColumn(AddMonth, \"Month Name\", each Date.ToText([Date], [Format=\"MMM yyyy\", Culture=\"en-US\"]), type text),",
                "    AddMonthNumber = Table.AddColumn(AddMonthName, \"Month Number\", each Date.Month([Date]), Int64.Type)",
                "in",
                "    AddMonthNumber"
              ],
              "type": "m"
            }
          }
        ]
      },
